# Advanced Shipping RAG - local inference settings (see SETUP.md)
# Copy this file to .env and enter real credentials ONLY in .env.
# These names are the application's configuration contract, not a Mem0 config file.
# Paths and URLs must be reachable from the machine running the connection check.
# For a remote RTX 5060 machine, replace 127.0.0.1 with its reachable host address.
# Do not expose Ollama/Qdrant directly to the public internet.

# ---- Environment / connection checks ----
APP_ENV=development
CONNECTION_TIMEOUT_SECONDS=15
# Absolute data path on the runtime machine; change when running on another PC.
DATA_DIR=./data

# ---- Legacy API variables: unused; all remote inference is blocked ----
# Leave these empty. Generation, evaluation and Mem0 use Ollama below.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
# Optional if your provider requires them; otherwise leave blank.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
LIVE_JUDGE_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY='''필수'''



# ---- Ollama embeddings: on the RTX 5060 runtime machine ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
COMPARISON_EMBEDDING_MODEL=qwen3-embedding:0.6b
COMPARISON_EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=1
# Application setting: reject oversized embedding input instead of silently cutting it.
EMBEDDING_TRUNCATE=false

# ---- Qdrant: PDF vectors and Mem0 memory vectors ----
QDRANT_URL='''필수'''
QDRANT_API_KEY='''필수'''



# Leave blank for a local server with no authentication.
QDRANT_DOCS_BGE_COLLECTION=check5060_docs_bge_v1
QDRANT_DOCS_QWEN_COLLECTION=check5060_docs_qwen06_v1
QDRANT_MEMORY_COLLECTION=check5060_mem_users_bge_v1
QDRANT_DISTANCE=Cosine
# Connection checking should not create, delete, or overwrite collections.

# ---- Mem0 OSS: Python library, not a separate Mem0 Cloud API ----
# No MEM0_API_KEY is needed for this OSS design.
# Mem0 uses LOCAL_MEM0_MODEL for extraction and Ollama for embeddings.
# Server-side switch. When false, QueryRequest.memory_enabled cannot turn memory back on.
MEMORY_ENABLED=true
MEM0_VECTOR_STORE=qdrant
MEM0_EMBEDDING_MODEL=bge-m3
MEM0_EMBEDDING_DIMENSIONS=1024
MEM0_HISTORY_DB_PATH=./runtime/5060-check/mem0/history.db
MEMORY_TOP_K=3
# Preference-string budget for the prompt. See docs/memory.md for the selection order.
MEMORY_CONTEXT_MAX_TOKENS=500
# Applied only to memories Mem0 returns a score for; scoreless rows always pass.
MEMORY_MIN_RELEVANCE_SCORE=0.3
MEMORY_PREFERENCE_MAX_CHARS=200
# Turn off memory read AND write for the course's comparative benchmark.
BENCHMARK_MEMORY_ENABLED=false
# Test identity only. Real user identity must later come from the server's auth context.
CONNECTION_TEST_USER_ID=connection-test-user

# ---- Local reranker: separate Transformers worker, not Ollama embed API ----
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# auto: select an available compatible GPU; test on the target RTX 5060 machine.
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=1
RERANKER_MAX_LENGTH=1024
# Optional for authenticated model downloads. Public model access normally needs no token.
HF_TOKEN=

# ---- Langfuse: use the exact base URL for your Cloud region or self-hosted server ----
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY='''필수'''
LANGFUSE_PUBLIC_KEY='''필수'''
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---- Retrieval defaults proposed in architecture v2 ----
RETRIEVAL_MODE=hybrid_rerank
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
RRF_K=60
RERANK_CANDIDATE_K=20
FINAL_TOP_K=4
CONTEXT_MAX_TOKENS=6000

# ---- Legacy evaluation variable (unused); LOCAL_EVALUATION_MODEL is used ----
EVALUATION_MODEL=gpt-6-luna
# Source JSON files repeat across parts. Read ONE evaluation set only.
EVALUATION_DIR=./data/advanced/Advanced_shipping_part01of09/evaluation

# ---- Redis Stack (선택): 시맨틱 캐시. 비슷한 질문이면 검색·LLM을 건너뛰고 저장된 답을 돌려준다 ----
# 검색 기능이 있는 Redis가 필요합니다. 예: docker run -d --name shipping-redis -p 6379:6379 redis/redis-stack-server:7.4.0-v8
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.1
SEMANTIC_CACHE_TTL_SECONDS=3600
# true면 벡터·규칙을 통과한 후보를 LLM에게 "같은 질문인가"로 한 번 더 확인한다(품목 교체 같은 일반명사 차이를 거름)
SEMANTIC_CACHE_LLM_CHECK=true
# 예: redis://127.0.0.1:6379 (비밀번호가 들어갈 수 있어 비밀값으로 다룸)
REDIS_VECTOR_URL=
# Separate Redis instance for sessions/cache/jobs, if used.
REDIS_CACHE_URL=
REDIS_DOCS_INDEX=idx:shipping:docs:v1
REDIS_MEMORY_INDEX=idx:shipping:memory:v1

# ---- Next-week security/session extension; keep disabled today ----
# Proposed application settings, not automatic Redis or Mem0 SDK configuration.
AUTH_ENABLED=false
SESSION_ENABLED=false
AUTHORIZATION_ENABLED=false
APPROVAL_WORKFLOW_ENABLED=false
SECURITY_EVALUATION_ENABLED=false
# Leave blank until the Redis session backend is implemented.
REDIS_SESSION_URL=
SESSION_KEY_PREFIX=shipping:session:
SESSION_COOKIE_NAME=shipping_session
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
# For the future HTTPS web deployment. localhost development may need a separate profile.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
# Never use an LLM response or an untrusted client field as an authorization decision.
# Authentication provider, authorization source of truth, and audit store: decide next week.

# Secrets must not appear in terminal output, connection reports, screenshots, or Git.
# A successful endpoint check does not by itself verify GPU memory use or RAG quality.


# Local-only execution and evaluation settings.
# No model calls are performed by editing this file.
EXECUTION_STAGE=local_smoke
GENERATION_LLM_PROVIDER=ollama
EVALUATION_LLM_PROVIDER=ollama
MEM0_LLM_PROVIDER=ollama
# Choose installed local models before running; do not silently call an external API.
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_EVALUATION_MODEL=qwen3:4b
LOCAL_MEM0_MODEL=qwen3:4b
ALLOW_EXTERNAL_LLM=false

# Legacy api_* stage names do not enable external inference.
EVAL_QUESTION_LIMIT=10
EVAL_QUESTION_IDS_FILE=evaluation/selection/core10.json
METRICS_DEVICE=rtx5060
PUBLISH_METRICS=false

# First milestone: local generation bounds. Benchmark/evaluation tools follow later.
LLM_MAX_OUTPUT_TOKENS=2048
LOCAL_CONTEXT_TOKENS=8192
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# All stages: generation, evaluation and Mem0 inference must remain local.
FORCE_LOCAL_ONLY=true
SMOKE_RUN=true
RUNTIME_DIR=./runtime/5060-check
EVAL_SELECTION=core10
REQUEST_TIMEOUT_SECONDS=120
# 4090 smoke: false. On 5060 8GB, enable and validate sequential model loading.
LOW_VRAM_MODE=true
# Optional: set 2048 on the target machine; changed embedding context creates a new index.
# EMBEDDING_CONTEXT_TOKENS=2048
EMBEDDING_CONTEXT_TOKENS=2048
